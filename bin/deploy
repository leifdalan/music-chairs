#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Deploy music-chairs to AWS: infrastructure, a release, and a public smoke check.

Settings live in project/deploy/config.json; the infrastructure is the Terraform
configuration in project/deploy/terraform, run through the repository's pinned
bin/terraform. Every subcommand first confirms that the AWS profile belongs to
the configured account and refuses otherwise, before any other AWS, Terraform or
SSH call. Nothing secret is written to the repository: the alert email is read
once from MUSIC_CHAIRS_ALERT_EMAIL into Parameter Store, Terraform's plan files
live in a temporary directory, the SSH key and pinned host key live under
~/.ssh, and the backup key is piped straight to the server.
"""

from __future__ import annotations

import argparse
import json
import os
import secrets
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
PROJECT = ROOT / "project"
DEPLOY = PROJECT / "deploy"
TERRAFORM_DIR = DEPLOY / "terraform"
# Never destroyed, replaced or forgotten by a plan: the live database's server
# and address, the backups and their protections, the keys the server holds, and
# the Google verification values.
PROTECTED = {
    "aws_lightsail_instance.app",
    "aws_lightsail_static_ip.app",
    "aws_lightsail_static_ip_attachment.app",
    "aws_s3_bucket.backups",
    "aws_s3_bucket_versioning.backups",
    "aws_s3_bucket_lifecycle_configuration.backups",
    "aws_s3_bucket_public_access_block.backups",
    "aws_s3_bucket_server_side_encryption_configuration.backups",
    "aws_s3_bucket_ownership_controls.backups",
    "aws_iam_user.backup",
    "aws_iam_user_policy.backup",
    "aws_iam_user.app",
    "aws_iam_user_policy.app",
    "aws_route53_record.google_verification",
}
# Files in project/deploy that never go to the server.
NOT_UPLOADED = {"terraform", "terraform-release.json"}
REMOTE_DEPLOY_DIR = "/tmp/music-chairs-deploy"
REMOTE_ARCHIVE = "/tmp/music-chairs-release.tgz"


class DeployError(Exception):
    """A refusal or failure with a message for the operator."""


def tool(variable: str, default: str) -> str:
    """The external command to run: an absolute override, or the default on PATH."""
    override = os.environ.get(variable)
    if override is not None:
        if not os.path.isabs(override):
            raise DeployError(f"{variable} must be an absolute path, got {override!r}")
        return override
    found = shutil.which(default)
    if found is None:
        raise DeployError(f"{default} is not installed or not on PATH")
    return found


class Deployment:
    def __init__(self, profile: str, dry_run: bool, refuse_infra_changes: bool = False) -> None:
        self.config = json.loads((DEPLOY / "config.json").read_text())
        self.profile = profile
        self.dry_run = dry_run
        # GitHub's deploy job (plan/phase-18.md): its role cannot change the
        # infrastructure, so a plan with changes stops before anything happens.
        self.refuse_infra_changes = refuse_infra_changes
        self.aws_cli = tool("MUSIC_CHAIRS_AWS", "aws")
        self.ssh_cli = tool("MUSIC_CHAIRS_SSH", "ssh")
        # Always the pinned wrapper; TOOLCHAIN_TERRAFORM (read by the wrapper) is
        # the one override.
        self.terraform_cli = str(ROOT / "bin" / "terraform")
        cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
        self.terraform_data = cache / "music-chairs" / "terraform" / "data" / "deploy"
        ssh_dir = Path.home() / ".ssh"
        self.key_file = ssh_dir / "music-chairs-lightsail"
        self.known_hosts = ssh_dir / "music-chairs-known-hosts"

    # -- AWS -----------------------------------------------------------------

    def aws(self, *args: str, region: str | None = None, check: bool = True) -> dict:
        command = [
            self.aws_cli,
            *args,
            "--profile",
            self.profile,
            "--region",
            region or self.config["region"],
            "--output",
            "json",
        ]
        result = subprocess.run(command, capture_output=True, text=True, check=False)
        if check and result.returncode != 0:
            raise DeployError(f"aws {' '.join(args[:2])} failed: {result.stderr.strip()}")
        if result.returncode != 0:
            return {"__error__": result.stderr}
        return json.loads(result.stdout) if result.stdout.strip() else {}

    def guard(self) -> None:
        identity = self.aws("sts", "get-caller-identity")
        account = identity.get("Account")
        if account != self.config["account"]:
            raise DeployError(
                f"profile {self.profile!r} is signed in to account {account}, but music-chairs "
                f"deploys only to {self.config['account']}; nothing was changed. Sign in with "
                f"`aws login --profile {self.profile}` to the right account."
            )
        print(f"account {account} confirmed for profile {self.profile}")

    def step(self, description: str) -> bool:
        """Announce a step; in a dry run, report it and skip it."""
        print(("would " if self.dry_run else "") + description)
        return not self.dry_run

    # -- infra ---------------------------------------------------------------

    def ensure_key_pair(self) -> None:
        name = self.config["keyPairName"]
        if not self.step(f"ensure Lightsail key pair {name} and {self.key_file}"):
            return
        existing = self.aws("lightsail", "get-key-pair", "--key-pair-name", name, check=False)
        if "__error__" not in existing:
            if not self.key_file.exists():
                raise DeployError(
                    f"Lightsail key pair {name} exists but {self.key_file} is missing; its private "
                    "key cannot be downloaded again. Restore the file from a backup, or follow "
                    "'Lost SSH key' in project/deploy/README.md. Re-creating the key pair does not "
                    "change the key the instance accepts. Nothing was changed."
                )
            return
        if self.key_file.exists():
            raise DeployError(
                f"{self.key_file} exists but Lightsail has no key pair {name}; it is not "
                "overwritten. Move it aside if it is no longer needed. Nothing was changed."
            )
        created = self.aws("lightsail", "create-key-pair", "--key-pair-name", name)
        self.key_file.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        descriptor = os.open(self.key_file, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(descriptor, "w") as handle:
            handle.write(created["privateKeyBase64"])

    # -- bootstrap -----------------------------------------------------------

    def bootstrap(self) -> None:
        """Creates Terraform's state bucket and the alert email parameter when absent."""
        config = self.config
        bucket = config["stateBucket"]
        parameter = config["alertEmailParameter"]
        if not self.step(f"ensure the state bucket {bucket} and the parameter {parameter}"):
            return
        found = self.aws("s3api", "head-bucket", "--bucket", bucket, check=False)
        if "__error__" in found:
            if "404" not in found["__error__"] and "Not Found" not in found["__error__"]:
                raise DeployError(f"could not check bucket {bucket}: {found['__error__'].strip()}")
            self.aws(
                "s3api",
                "create-bucket",
                "--bucket",
                bucket,
                "--create-bucket-configuration",
                f"LocationConstraint={config['region']}",
            )
            print(f"created state bucket {bucket}")
        # Re-applied every time (each call is idempotent), so a bootstrap that
        # stopped part-way still ends with a private, encrypted, versioned bucket.
        self.aws(
            "s3api",
            "put-public-access-block",
            "--bucket",
            bucket,
            "--public-access-block-configuration",
            "BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,"
            "RestrictPublicBuckets=true",
        )
        self.aws(
            "s3api",
            "put-bucket-ownership-controls",
            "--bucket",
            bucket,
            "--ownership-controls",
            "Rules=[{ObjectOwnership=BucketOwnerEnforced}]",
        )
        self.aws(
            "s3api",
            "put-bucket-encryption",
            "--bucket",
            bucket,
            "--server-side-encryption-configuration",
            "Rules=[{ApplyServerSideEncryptionByDefault={SSEAlgorithm=AES256}}]",
        )
        self.aws(
            "s3api",
            "put-bucket-versioning",
            "--bucket",
            bucket,
            "--versioning-configuration",
            "Status=Enabled",
        )
        existing = self.aws("ssm", "get-parameter", "--name", parameter, check=False)
        if "__error__" not in existing:
            return
        if "ParameterNotFound" not in existing["__error__"]:
            raise DeployError(f"could not read {parameter}: {existing['__error__'].strip()}")
        email = os.environ.get("MUSIC_CHAIRS_ALERT_EMAIL", "").strip()
        if not email:
            raise DeployError(
                f"set MUSIC_CHAIRS_ALERT_EMAIL once to create {parameter}; it is kept in AWS "
                "only, never in the repository. Nothing else was changed."
            )
        # The address goes through a private file that is removed at once, never on
        # a command line (the AWS CLI cannot read --cli-input-json from a pipe).
        with tempfile.TemporaryDirectory() as work:
            request = Path(work) / "parameter.json"
            descriptor = os.open(request, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(descriptor, "w") as handle:
                json.dump({"Name": parameter, "Type": "SecureString", "Value": email}, handle)
            self.aws("ssm", "put-parameter", "--cli-input-json", f"file://{request}")
        print(f"created {parameter}")

    # -- infra ---------------------------------------------------------------

    def terraform(self, *args: str, capture: bool = False) -> str:
        env = {
            **os.environ,
            "AWS_PROFILE": self.profile,
            "TF_IN_AUTOMATION": "1",
            "TF_INPUT": "0",
            "TF_DATA_DIR": str(self.terraform_data),
        }
        result = subprocess.run(
            [self.terraform_cli, f"-chdir={TERRAFORM_DIR}", *args],
            env=env,
            capture_output=capture,
            text=True,
            check=False,
        )
        if result.returncode != 0:
            detail = (result.stderr or "").strip() if capture else ""
            raise DeployError(f"terraform {args[0]} failed" + (f": {detail}" if detail else ""))
        return result.stdout if capture else ""

    def terraform_init(self) -> None:
        config = self.config
        self.terraform(
            "init",
            "-input=false",
            "-lockfile=readonly",
            "-reconfigure",
            f"-backend-config=bucket={config['stateBucket']}",
            "-backend-config=key=music-chairs.tfstate",
            f"-backend-config=region={config['region']}",
            f"-backend-config=profile={self.profile}",
        )

    def infra(self) -> None:
        self.ensure_key_pair()
        if self.dry_run:
            existing = self.aws(
                "s3api", "head-bucket", "--bucket", self.config["stateBucket"], check=False
            )
            if "__error__" in existing:
                raise DeployError(
                    "the state bucket does not exist yet; run ./bin/deploy bootstrap first"
                )
        print("plan the infrastructure with Terraform")
        self.terraform_init()
        with tempfile.TemporaryDirectory() as work:
            plan_file = str(Path(work) / "infra.tfplan")
            self.terraform("plan", "-input=false", "-out", plan_file)
            plan = json.loads(self.terraform("show", "-json", plan_file, capture=True))
            refuse_destructive(plan)
            summary = summarize(plan)
            print(summary)
            if self.refuse_infra_changes and summary != "plan: no changes":
                raise DeployError(
                    "refusing: infrastructure changes are applied by hand before merging "
                    "(./bin/deploy infra --profile music-chairs). Nothing was changed."
                )
            if not self.step("apply the plan"):
                return
            self.terraform("apply", "-input=false", plan_file)
        print("infrastructure up to date")

    # -- release -------------------------------------------------------------

    def outputs(self) -> dict[str, str]:
        self.terraform_init()
        shown = json.loads(self.terraform("output", "-json", capture=True))
        return {name: item["value"] for name, item in shown.items()}

    def pin_host_key(self, address: str) -> None:
        details = self.aws(
            "lightsail",
            "get-instance-access-details",
            "--instance-name",
            self.config["instanceName"],
            "--protocol",
            "ssh",
        )["accessDetails"]
        keys = [
            f"{address} {key['algorithm']} {key['publicKey']}"
            for key in details.get("hostKeys", [])
        ]
        if not keys:
            raise DeployError(
                "Lightsail reported no host keys for the instance yet; try again shortly"
            )
        self.known_hosts.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        self.known_hosts.write_text("\n".join(keys) + "\n")

    def ssh(self, address: str, command: str, stdin: bytes | None = None) -> str:
        argv = [
            self.ssh_cli,
            "-i",
            str(self.key_file),
            "-o",
            f"UserKnownHostsFile={self.known_hosts}",
            "-o",
            "StrictHostKeyChecking=yes",
            "-o",
            "BatchMode=yes",
            f"{self.config['sshUser']}@{address}",
            command,
        ]
        result = subprocess.run(argv, input=stdin, capture_output=True, check=False)
        if result.returncode != 0:
            raise DeployError(
                f"on the server, `{command.split()[0]} …` failed:\n"
                + result.stderr.decode(errors="replace").strip()
                + "\n"
                + result.stdout.decode(errors="replace").strip()
            )
        return result.stdout.decode(errors="replace")

    def release_name(self) -> str:
        def git(*args: str) -> str:
            return subprocess.run(
                ["git", *args], cwd=ROOT, capture_output=True, text=True, check=True
            ).stdout.strip()

        name = git("rev-parse", "--short", "HEAD")
        if git("status", "--porcelain", "--", "project"):
            name += "-dirty"
        # Unique per install, so a reinstall of the same commit never overwrites the
        # release being served and can still roll back to it.
        return f"{name}-{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())}"

    def release(self) -> None:
        config = self.config
        if self.step("read the Terraform outputs and pin the instance's SSH host key"):
            outputs = self.outputs()
            address = outputs["static_ip_address"]
            self.pin_host_key(address)
        if self.step("upload project/deploy and run provision.sh (idempotent server setup)"):
            node_version = json.loads((PROJECT / "package.json").read_text())["devEngines"][
                "runtime"
            ]["version"]
            with tempfile.TemporaryFile() as bundle:
                with tarfile.open(fileobj=bundle, mode="w:gz") as tar:
                    for path in sorted(DEPLOY.iterdir()):
                        if path.name not in NOT_UPLOADED:
                            tar.add(path, arcname=path.name)
                bundle.seek(0)
                self.ssh(
                    address,
                    f"rm -rf {REMOTE_DEPLOY_DIR} && mkdir -p {REMOTE_DEPLOY_DIR} && "
                    f"tar -xzf - -C {REMOTE_DEPLOY_DIR}",
                    stdin=bundle.read(),
                )
            env = {
                "DOMAIN": config["domain"],
                "PUBLIC_URL": f"https://{config['domain']}",
                "NODE_VERSION": node_version,
                "BUCKET": outputs["backup_bucket_name"],
                "REGION": config["region"],
                "GOOGLE_CLIENT_ID": config["googleClientId"],
                "GOOGLE_SECRET_PARAMETER": config["googleSecretParameter"],
                "SSH_USER": config["sshUser"],
            }
            assignments = " ".join(f"{k}={v}" for k, v in env.items())
            print(
                self.ssh(
                    address, f"sudo env {assignments} bash {REMOTE_DEPLOY_DIR}/provision.sh"
                ).strip()
            )
        if self.step("install the backup and app keys on the server if it lacks them"):
            # The backup runs as music-chairs; the app key is read only by root
            # (fetch-secret.sh), so the app itself cannot read it.
            self.ensure_server_key(
                address, outputs["backup_user_name"], "/etc/music-chairs/backup.env", "music-chairs"
            )
            self.ensure_server_key(
                address, outputs["app_user_name"], "/etc/music-chairs/app.env", "root"
            )
        if self.step(
            "build the app and install it as a release (rolls back on a failed health check)"
        ):
            subprocess.run(["corepack", "pnpm", "run", "build"], cwd=PROJECT, check=True)
            name = self.release_name()
            with tempfile.TemporaryFile() as archive:
                with tarfile.open(fileobj=archive, mode="w:gz") as tar:
                    for item in ("build", "package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml"):
                        tar.add(PROJECT / item, arcname=item)
                archive.seek(0)
                self.ssh(address, f"cat > {REMOTE_ARCHIVE}", stdin=archive.read())
            print(
                self.ssh(
                    address,
                    "sudo bash /usr/local/lib/music-chairs/install-release.sh "
                    f"{REMOTE_ARCHIVE} {name}",
                ).strip()
            )
        if self.step("check the running service carries the public URL and Google client id"):
            shown = self.ssh(address, "systemctl show -p Environment music-chairs")
            for expected in (
                f"MUSIC_CHAIRS_PUBLIC_URL=https://{config['domain']}",
                f"MUSIC_CHAIRS_GOOGLE_CLIENT_ID={config['googleClientId']}",
            ):
                if expected not in shown:
                    raise DeployError(f"the running service lacks {expected}: {shown.strip()}")

    def ensure_server_key(self, address: str, user: str, path: str, owner: str) -> None:
        """Gives the server an access key for `user` at `path` (mode 600) unless it has one."""
        # Any SSH failure raises here, so an unreachable server never rotates the key.
        state = self.ssh(
            address,
            f"if sudo test -f {path}; then echo present; else echo missing; fi",
        ).strip()
        if state == "present":
            return
        if state != "missing":
            raise DeployError(f"could not tell whether the server has {path}: {state!r}")
        # IAM allows two keys per user; old ones are useless once the server lost them.
        for key in self.aws("iam", "list-access-keys", "--user-name", user)["AccessKeyMetadata"]:
            self.aws(
                "iam",
                "delete-access-key",
                "--user-name",
                user,
                "--access-key-id",
                key["AccessKeyId"],
            )
        key = self.aws("iam", "create-access-key", "--user-name", user)["AccessKey"]
        content = (
            f"AWS_ACCESS_KEY_ID={key['AccessKeyId']}\n"
            f"AWS_SECRET_ACCESS_KEY={key['SecretAccessKey']}\n"
        )
        self.ssh(
            address,
            f"sudo install -o {owner} -g {owner} -m 600 /dev/stdin {path}",
            stdin=content.encode(),
        )

    # -- smoke ---------------------------------------------------------------

    def smoke(self) -> None:
        origin = f"https://{self.config['domain']}"
        if not self.step(f"run the non-mutating smoke against {origin}"):
            return

        def fetch(path: str, data: dict | None = None) -> tuple[int, str]:
            body = urllib.parse.urlencode(data).encode() if data is not None else None
            # Posts carry the Origin header a browser sends, so React Router's
            # cross-site check sees what real form submissions look like.
            headers = {"Origin": origin} if body is not None else {}
            request = urllib.request.Request(origin + path, data=body, headers=headers)
            try:
                with urllib.request.urlopen(request, timeout=20) as response:
                    return response.status, response.read().decode()
            except urllib.error.HTTPError as error:
                return error.code, error.read().decode()
            except OSError as error:  # DNS, connection, TLS certificate or timeout
                return 0, str(error)

        privacy = fetch("/privacy")
        checks = [
            ("GET /", fetch("/"), 200, 'name="groupName"'),
            ("GET /healthz", fetch("/healthz"), 200, "ok"),
            ("GET /privacy", privacy, 200, "including the Limited Use requirements"),
            ("GET /privacy (contact)", privacy, 200, "leifdalan+rtc@gmail.com"),
            (
                "GET /join/<unknown>",
                fetch(f"/join/{secrets.token_urlsafe(16)}"),
                404,
                "Page not found",
            ),
            (
                "POST /?index with a blank name",
                fetch("/?index", {"groupName": " ", "displayName": "Smoke", "timeZone": "UTC"}),
                400,
                "Group name is required.",
            ),
        ]
        failures = [
            f"{label}: " + (f"HTTP {status}" if status else body)
            for label, (status, body), want, text in checks
            if status != want or text not in body
        ]
        for label, (status, _), _, _ in checks:
            print(f"  {label} -> {status}")
        if failures:
            raise DeployError("smoke failed: " + "; ".join(failures))
        print(f"  Google sign-in: {google_sign_in(origin)}")
        print(f"smoke passed against {origin}")


def refuse_destructive(plan: dict) -> None:
    """Refuses a plan that would destroy, replace or forget a protected resource."""
    for change in plan.get("resource_changes", []):
        actions = change.get("change", {}).get("actions", [])
        if change.get("address") in PROTECTED and ("delete" in actions or "forget" in actions):
            raise DeployError(
                f"refusing: this change would replace, remove or forget {change['address']}, "
                "which the live service depends on. Nothing was changed."
            )


def summarize(plan: dict) -> str:
    """The plan's counts, as Terraform reports them."""
    counts = {"create": 0, "update": 0, "delete": 0, "forget": 0}
    for change in plan.get("resource_changes", []):
        for action in change.get("change", {}).get("actions", []):
            if action in counts:
                counts[action] += 1
    if not any(counts.values()):
        return "plan: no changes"
    summary = (
        f"plan: {counts['create']} to add, {counts['update']} to change, "
        f"{counts['delete']} to destroy"
    )
    return summary + (f", {counts['forget']} to forget" if counts["forget"] else "")


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args: object, **kwargs: object) -> None:
        return None


def google_sign_in(origin: str) -> str:
    """`available` when /auth/google sends the browser to Google, `unavailable` on its 503."""
    opener = urllib.request.build_opener(_NoRedirect)
    try:
        with opener.open(origin + "/auth/google", timeout=20) as response:
            status, location = response.status, ""
    except urllib.error.HTTPError as error:
        status, location = error.code, error.headers.get("Location", "")
    except OSError as error:
        raise DeployError(f"smoke failed: GET /auth/google: {error}") from error
    if status == 302 and location.startswith("https://accounts.google.com/"):
        return "available"
    if status == 503:
        return "unavailable"
    raise DeployError(f"smoke failed: GET /auth/google: HTTP {status} {location}".strip())


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=["bootstrap", "infra", "release", "smoke", "all"])
    parser.add_argument(
        "--profile", default=None, help="AWS CLI profile (default from config.json)"
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="confirm the account, then list the steps without running them",
    )
    parser.add_argument(
        "--refuse-infra-changes",
        action="store_true",
        help="stop before applying any infrastructure change (GitHub's deploy job)",
    )
    args = parser.parse_args()
    try:
        config = json.loads((DEPLOY / "config.json").read_text())
        deployment = Deployment(
            args.profile or config["profile"], args.dry_run, args.refuse_infra_changes
        )
        deployment.guard()
        if args.command in ("bootstrap", "all"):
            deployment.bootstrap()
        if args.command in ("infra", "all"):
            deployment.infra()
        if args.command in ("release", "all"):
            deployment.release()
        if args.command in ("smoke", "all"):
            deployment.smoke()
    except DeployError as error:
        print(f"deploy: {error}", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as error:
        command = " ".join(str(part) for part in error.cmd)
        print(f"deploy: `{command}` failed with exit status {error.returncode}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
