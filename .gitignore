# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Agentic harness runtime state
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/projects/
.codex/cache/
.kickoff/

# Root-level methodology test runtime state
__pycache__/
.pytest_cache/

# impeccable-ignore-start
# Impeccable (.claude/skills/impeccable): ephemeral output, runtime state and
# per-developer overrides. Shared artifacts stay tracked: config.json,
# design.json, surfaces/*.md. Critique snapshots stay local: they record the
# machine's absolute path (target_identity), which the repo never commits.
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
**/.impeccable/*.png
**/.impeccable/review/
**/.impeccable/questions/
**/.impeccable/live/
**/.impeccable/critique/
# impeccable-ignore-end
